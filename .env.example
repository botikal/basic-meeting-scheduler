# Copy to `.env` and edit. `.env` is git-ignored - never commit real secrets.

APP_NAME="Meeting Scheduler"
BASE_URL="http://localhost:8000"
DATABASE_URL="sqlite:///./scheduler.db"

HOST_NAME="Acme Corp"

# Availability (business hours are in TIMEZONE)
TIMEZONE="UTC"
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=17
SLOT_MINUTES=30
# JSON list, Mon=0 .. Sun=6
AVAILABLE_WEEKDAYS=[0,1,2,3,4]
BOOKING_HORIZON_DAYS=14
MIN_NOTICE_HOURS=2

# Staff login for /admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Email - leave SMTP_HOST empty to print emails to the console instead
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="scheduler@example.com"
