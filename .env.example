# Copy to `.env` and edit. `.env` is git-ignored - never commit real secrets.

# Generate a real key for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY="dev-insecure-key-change-me"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed once you serve over HTTPS on a real domain:
# CSRF_TRUSTED_ORIGINS=https://scheduler.example.com

# DATABASE_URL="sqlite:///db.sqlite3"

HOST_NAME="Acme Corp"
BASE_URL="http://localhost:8000"

# Availability. Business hours are in BUSINESS_TIMEZONE; clients see DISPLAY_TIMEZONE.
BUSINESS_TIMEZONE="Asia/Seoul"
DISPLAY_TIMEZONE="UTC"
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
SLOT_MINUTES=30
# Longest booking a client may make, in back-to-back slots (1 => 30 min only)
MAX_CONSECUTIVE_SLOTS=1
# Comma-separated, Mon=0 .. Sun=6
AVAILABLE_WEEKDAYS=0,1,2,3,4
BOOKING_HORIZON_DAYS=14
MIN_NOTICE_HOURS=2

# Email - leave EMAIL_HOST empty to print emails to the console instead
EMAIL_FROM="scheduler@example.com"
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS=True

# Google Calendar / Meet - optional, leave both blank to skip it. GOOGLE_TOKEN_FILE
# is written by `python manage.py google_oauth_setup <client_secret.json>` - see
# the "Google Meet" section in README.md.
GOOGLE_TOKEN_FILE=""
GOOGLE_CALENDAR_ID=""
